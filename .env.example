# ==============================================================================
# PÈRÔKADÔ — Variables d'environnement (.env)
# Copiez ce fichier en .env en local (ne jamais commiter .env sur GitHub !)
# Sur Vercel : Settings -> Environment Variables
# ==============================================================================

# 1. BASE DE DONNÉES NEON (PostgreSQL) — OBLIGATOIRE EN PRODUCTION SUR VERCEL
# Format : postgresql://neondb_owner:MOT_DE_PASSE@ep-xxxx-pooler.eu-west-3.aws.neon.tech/neondb?sslmode=require
# En local, si vide, Pèrôkadô utilise automatiquement une base PostgreSQL locale (PGlite) de démonstration.
DATABASE_URL=

# 2. SÉCURITÉ CONSOLE SELLER CENTRAL (application admin.html distincte) — OBLIGATOIRE EN PRODUCTION
# Choisissez un mot de passe robuste (au moins 12 caractères) pour l'administrateur principal.
ADMIN_PASSWORD=

# Clé secrète HMAC-SHA256 pour signer les sessions (64 caractères hex recommandés).
# Générez-la avec : npm run secret:generate
SESSION_SECRET=

# 3. NUMÉROS OFFICIELS PÈRÔKADÔ & PAIEMENT 100% WAVE CÔTE D'IVOIRE
# Service client WhatsApp (assistance uniquement) : +225 05 01 30 33 43
WHATSAPP_NUMBER=2250501303343
# Numéro Wave dédié exclusivement à la réception des paiements : +225 05 46 69 74 78
WAVE_PHONE=+225 05 46 69 74 78
WAVE_PAYMENT_URL=

# API Wave Business Checkout Côte d'Ivoire (encaissement 100% automatique sans intervention humaine)
# Portail officiel : https://business.wave.com/dev-portal
# Webhook à configurer sur Wave Business : https://perokado.com/api/webhooks/wave (événement: checkout.session.completed)
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_SIGNING_SECRET=

# Optionnel — Alertes automatiques 24h/24 vers vos livreurs à Daloa (Telegram Bot 100% gratuit ou Webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ORDER_ALERT_WEBHOOK_URL=

# 4. ORIGINES AUTORISÉES (domaine officiel Pèrôkadô)
PUBLIC_ORIGIN=https://perokado.com
ADMIN_ORIGIN=
