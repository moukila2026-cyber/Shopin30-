# ==============================================================================
# PÈRÔKADÔ — Variables d'environnement (.env)
# Copiez ce fichier en .env en local (ne jamais commiter .env sur GitHub !)
# Sur Vercel : Settings -> Environment Variables
# ==============================================================================

# 1. BASE DE DONNÉES NEON (PostgreSQL) — OBLIGATOIRE EN PRODUCTION SUR VERCEL
# Format : postgresql://neondb_owner:MOT_DE_PASSE@ep-xxxx-pooler.eu-west-3.aws.neon.tech/neondb?sslmode=require
# En local, si vide, Pèrôkadô utilise automatiquement une base PostgreSQL locale (PGlite) de démonstration.
DATABASE_URL=

# 2. SÉCURITÉ CONSOLE SELLER CENTRAL (application admin.html distincte) — OBLIGATOIRE EN PRODUCTION
# Choisissez un mot de passe robuste (au moins 12 caractères) pour l'administrateur principal.
ADMIN_PASSWORD=

# Clé secrète HMAC-SHA256 pour signer les sessions (64 caractères hex recommandés).
# Générez-la avec : npm run secret:generate
SESSION_SECRET=

# 3. PAIEMENTS INSTANTANÉS SASPAY (https://app.saspay.me) & WAVE
WHATSAPP_NUMBER=2250501303343
WAVE_PHONE=05 01 30 33 43
WAVE_PAYMENT_URL=

# Recommandé — Paiement instantané SasPay Côte d'Ivoire (Wave CI, Orange Money, MTN MoMo, Moov, Carte)
# Webhook à configurer sur app.saspay.me : https://votre-domaine/api/webhooks/saspay (événement: transaction.success)
SASPAY_API_KEY=
SASPAY_WEBHOOK_SECRET=
# Optionnel : ADD_ON (frais payés par le client) ou DEDUCTED (frais déduits) si ALLOW_CLIENT_OVERRIDE est actif
SASPAY_FEE_CHARGE_MODE=
# Optionnel : reversement auto API (exige IP serveur fixe whitelistée sur SasPay + scope PAYOUT/BOTH)
SASPAY_AUTO_PAYOUT=false
SASPAY_PAYOUT_MSISDN=
SASPAY_PAYOUT_METHOD=wave_ci

# Alternative — API Wave Business Checkout directe
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

# Optionnel — Alertes automatiques 24h/24 vers vos livreurs à Daloa (Telegram Bot 100% gratuit ou Webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ORDER_ALERT_WEBHOOK_URL=

# 4. ORIGINES AUTORISÉES (optionnel si vous reliez un sous-domaine admin.votredomaine.ci)
PUBLIC_ORIGIN=
ADMIN_ORIGIN=
